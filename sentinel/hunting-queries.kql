// Complete, version-safe view for at-least-once Event Grid delivery.
let CandidateChunks = materialize(
    GitHubCopilotAudit_CL
    | where TimeGenerated >= ago(30d)
    | extend
        ChunkIndex=coalesce(RawChunkIndex, 0),
        ChunkCount=coalesce(RawChunkCount, 1),
        ContentVersion=coalesce(RawContentHash, "legacy")
);
let CompleteVersions = materialize(
    CandidateChunks
    | summarize
        LatestIngestedAt=max(IngestedAt),
        PresentChunks=dcount(ChunkIndex),
        ExpectedChunks=max(ChunkCount)
        by EventId, ContentVersion
    | where PresentChunks == ExpectedChunks
    | summarize arg_max(LatestIngestedAt, *) by EventId
);
let DeduplicatedChunks = materialize(
    CandidateChunks
    | join kind=inner (
        CompleteVersions
        | project EventId, ContentVersion
    ) on EventId, ContentVersion
    | summarize arg_max(IngestedAt, *) by EventId, ContentVersion, ChunkIndex
);
let DeduplicatedAudit = materialize(
    DeduplicatedChunks
    | where ChunkIndex == 0
);
DeduplicatedAudit
| summarize Events=count(), Users=dcount(UserId) by bin(TimeGenerated, 1h), EventType
| order by TimeGenerated desc

// Reconstruct a complete raw record. Restrict results to authorized responders.
let target_event_id = "<EventId>";
DeduplicatedChunks
| where EventId == target_event_id
| order by ChunkIndex asc
| summarize RawEvent=strcat_array(make_list(RawEvent), ""),
            RawEncoding=any(RawEncoding),
            RawContentHash=any(RawContentHash),
            ActualChunks=dcount(ChunkIndex),
            ExpectedChunks=max(ChunkCount)

// Parse health with retained raw content available to authorized investigators.
DeduplicatedAudit
| where ParseStatus != "parsed"
| summarize Records=count(), Bytes=sum(PayloadBytes) by ParseStatus, bin(IngestedAt, 1h)
| order by IngestedAt desc

// Duplicate deliveries indicate retries or replay activity.
GitHubCopilotAudit_CL
| where IngestedAt >= ago(7d) and coalesce(RawChunkIndex, 0) == 0
| summarize Deliveries=count(), FirstSeen=min(IngestedAt), LastSeen=max(IngestedAt) by EventId
| where Deliveries > 1
| order by Deliveries desc

// Unusual hourly volume compared with the prior seven-day hourly baseline.
let Hourly =
    GitHubCopilotAudit_CL
    | where TimeGenerated between (ago(8d) .. now())
    | where coalesce(RawChunkIndex, 0) == 0
    | summarize Events=dcount(EventId) by bin(TimeGenerated, 1h);
let Baseline = toscalar(Hourly | where TimeGenerated < ago(1d) | summarize avg(Events));
Hourly
| where TimeGenerated >= ago(1d)
| where Events > max_of(50, Baseline * 3.0)
| project TimeGenerated, Events, Baseline

// Model and endpoint combinations newly observed in the last day.
let Known =
    GitHubCopilotAudit_CL
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where coalesce(RawChunkIndex, 0) == 0
    | summarize by Model, Endpoint;
GitHubCopilotAudit_CL
| where TimeGenerated >= ago(1d) and coalesce(RawChunkIndex, 0) == 0
| summarize Events=dcount(EventId) by Model, Endpoint
| join kind=leftanti Known on Model, Endpoint
| order by Events desc

// Tool names are normalized; full tool arguments remain in restricted RawEvent.
GitHubCopilotAudit_CL
| where TimeGenerated >= ago(7d) and coalesce(RawChunkIndex, 0) == 0
| extend Tools=parse_json(ToolNames)
| mv-expand ToolName=Tools to typeof(string)
| where isnotempty(ToolName)
| summarize Events=dcount(EventId), Users=dcount(UserId) by ToolName
| order by Events desc
